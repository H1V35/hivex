{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decisions": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "kind": {
            "type": "string",
            "enum": ["decision", "constraint", "definition", "lesson"]
          },
          "status": {
            "type": "string",
            "enum": ["current", "proposed", "historical", "uncertain"]
          },
          "conditions": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "exceptions": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "lineStart": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "lineEnd": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "document",
          "text",
          "kind",
          "status",
          "conditions",
          "exceptions",
          "reason",
          "lineStart",
          "lineEnd"
        ],
        "additionalProperties": false
      }
    },
    "relationships": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["requires", "exception-to", "supersedes", "supports", "contradicts"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "evidence": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "document": {
                  "type": "string",
                  "minLength": 1
                },
                "lineStart": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "lineEnd": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["document", "lineStart", "lineEnd"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "from", "to", "type", "reason", "evidence"],
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  },
  "required": ["decisions", "relationships", "uncertainties"],
  "additionalProperties": false
}
